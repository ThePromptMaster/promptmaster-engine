OPENROUTER_API_KEY=your-openrouter-api-key-here
# Optional. A call moves to this key when OpenRouter refuses the first for credit.
OPENROUTER_API_KEY_2=
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# Supabase project URL — used to build the JWKS URL and the expected token
# issuer. Required once any client sends a token; without it, token
# verification returns 500.
SUPABASE_URL=https://your-project.supabase.co

# Only needed if the project still signs tokens with the legacy HS256 shared
# secret. Projects on asymmetric keys (ES256/RS256) resolve via JWKS and can
# leave this unset.
SUPABASE_JWT_SECRET=

# Staged rollout switch. Ship "false" first so the backend verifies a token
# when present but never rejects a request without one; deploy the frontend's
# token attachment; then flip to "true". Frontend and backend are separate
# deploy units, so enforcing before the frontend ships takes the app down.
# Defaults to true when unset.
AUTH_ENFORCED=false

# Connected accounts (Gmail, Google Calendar, Google Drive, Outlook, OneDrive)
# go through Composio, which holds the connections keyed by Supabase user id.
# Without a key, /api/connections answers 503 and nothing else is affected.
COMPOSIO_API_KEY=
# "mock" serves scripted accounts for the browser tests. Refused in production.
COMPOSIO_MODE=
